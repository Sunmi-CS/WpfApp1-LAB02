<UserControl x:Class="WpfApp1.Views.IngresoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Registro de Ingreso" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextColor}" />
            <TextBlock Text="Control y registro de vehículos que ingresan a planta" Foreground="{StaticResource SecondaryTextColor}" Margin="0,6,0,18" />

            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Left column: Documentación -->
                <Border Style="{StaticResource CardStyle}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Documentación" FontWeight="Bold" Foreground="{StaticResource TextColor}" />
                        <TextBlock Text="Tipo de documento y número" Foreground="{StaticResource SecondaryTextColor}" FontSize="12" Margin="0,6,0,12" />

                        <TextBlock Text="Tipo de documento" Style="{StaticResource LabelStyle}" />
                        <ComboBox SelectedValue="{Binding TipoDocumento}" Style="{StaticResource ComboBoxStyle}">
                            <ComboBoxItem Content="DNI" />
                            <ComboBoxItem Content="RUC" />
                            <ComboBoxItem Content="OTRO" />
                        </ComboBox>

                        <TextBlock Text="Número de documento" Style="{StaticResource LabelStyle}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding NumeroDocumento}" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                </Border>

                <!-- Right column: Vehículo y conductor -->
                <Border Style="{StaticResource CardStyle}" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Vehículo y Conductor" FontWeight="Bold" Foreground="{StaticResource TextColor}" />
                        <TextBlock Text="Información del vehículo y conductor" Foreground="{StaticResource SecondaryTextColor}" FontSize="12" Margin="0,6,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Placa" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding Placa}" Style="{StaticResource InputStyle}" />

                                <TextBlock Text="Turno" Style="{StaticResource LabelStyle}" Margin="0,8,0,0" />
                                <ComboBox SelectedValue="{Binding Turno}" Style="{StaticResource ComboBoxStyle}">
                                    <ComboBoxItem Content="Mañana" />
                                    <ComboBoxItem Content="Tarde" />
                                    <ComboBoxItem Content="Noche" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Nombre Conductor" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding Conductor}" Style="{StaticResource InputStyle}" />

                                <TextBlock Text="Nombre Cliente" Style="{StaticResource LabelStyle}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding Cliente}" Style="{StaticResource InputStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Guardar Ingreso" Command="{Binding GuardarCommand}" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Datos adicionales -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fecha y Hora" Style="{StaticResource LabelStyle}" />
                        <DatePicker SelectedDate="{Binding FechaHora, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Peso de Ingreso" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding PesoText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource SuccessColor}" FontWeight="SemiBold" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>

</UserControl>

