<UserControl x:Class="WpfApp1.Views.ReporteCargasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Reporte de Cargas" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextColor}" />
        <TextBlock Text="Consulta de cargas registradas" Foreground="{StaticResource SecondaryTextColor}" Margin="0,6,0,12" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Fecha Inicio" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FechaInicio}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Fecha Fin" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FechaFin}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Placa" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Width="160"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Conductor" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Conductor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Width="160"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Producto" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Producto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Width="160"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Buscar" Command="{Binding BuscarCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Style="{StaticResource OutlineButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <DataGrid ItemsSource="{Binding Resultados}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora}" Width="150" />
                    <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="100" />
                    <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="100" />
                    <DataGridTextColumn Header="Conductor" Binding="{Binding Conductor}" Width="*" />
                    <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="120" />
                    <DataGridTextColumn Header="Peso" Binding="{Binding Peso}" Width="100" />
                    <DataGridTextColumn Header="Transporte" Binding="{Binding Transporte}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>

</UserControl>
