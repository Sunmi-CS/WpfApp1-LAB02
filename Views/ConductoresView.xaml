<UserControl x:Class="WpfApp1.Views.ConductoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>


		<!-- ============================= -->
		<!-- TITULO -->
		<!-- ============================= -->

		<TextBlock
            Grid.Row="0"
            Text="Mantenimiento de Conductores"
            FontSize="22"
            FontWeight="Bold"
            Foreground="{StaticResource TextColor}"/>

		<TextBlock
            Grid.Row="1"
            Text="Ingrese los datos del conductor"
            Foreground="{StaticResource SecondaryTextColor}"
            Margin="0,6,0,16"/>


		<!-- ============================= -->
		<!-- CONTENIDO -->
		<!-- ============================= -->

		<Grid Grid.Row="2">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="380"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>


			<!-- ============================= -->
			<!-- FORMULARIO -->
			<!-- ============================= -->

			<Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Padding="16">

				<StackPanel>

					<TextBlock
                        Text="Nuevo conductor"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextColor}"/>

					<TextBlock
                        Text="Ingrese los datos del conductor"
                        Foreground="{StaticResource SecondaryTextColor}"
                        FontSize="12"
                        Margin="0,6,0,16"/>


					<TextBlock
                        Text="Nombre"
                        Style="{StaticResource LabelStyle}"/>

					<TextBox
                        Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>


					<TextBlock
                        Text="Licencia"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,12,0,0"/>

					<TextBox
                        Text="{Binding Licencia, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>


					<TextBlock
                        Text="Transporte"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,12,0,0"/>

					<TextBox
                        Text="{Binding Transporte, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputStyle}"/>


					<Button
                        Content="Guardar conductor"
                        Command="{Binding GuardarConductorCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0"/>


					<TextBlock
                        Text="{Binding Mensaje}"
                        Foreground="{StaticResource SuccessColor}"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"/>

				</StackPanel>

			</Border>


			<!-- ============================= -->
			<!-- LISTADO -->
			<!-- ============================= -->

			<Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}"
                Padding="16">

				<Grid>

					<Grid.RowDefinitions>

						<!-- Cabecera -->
						<RowDefinition Height="Auto"/>

						<!-- Descripción -->
						<RowDefinition Height="Auto"/>

						<!-- Tabla -->
						<RowDefinition Height="*"/>

					</Grid.RowDefinitions>


					<!-- ============================= -->
					<!-- CABECERA -->
					<!-- ============================= -->

					<Grid Grid.Row="0">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>


						<TextBlock
                            Text="Listado de conductores"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextColor}"
                            VerticalAlignment="Center"/>


						<Button
                            Grid.Column="1"
                            Content="+ Nuevo conductor"
                            Style="{StaticResource OutlineButton}"
                            Margin="12,0,0,0"/>

					</Grid>


					<!-- ============================= -->
					<!-- DESCRIPCION -->
					<!-- ============================= -->

					<TextBlock
                        Grid.Row="1"
                        Text="Listado de conductores registrados"
                        Foreground="{StaticResource SecondaryTextColor}"
                        FontSize="12"
                        Margin="0,6,0,14"/>


					<!-- ============================= -->
					<!-- DATAGRID -->
					<!-- ============================= -->

					<DataGrid
                        Grid.Row="2"
                        ItemsSource="{Binding Conductores}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="None"
                        RowHeight="48"
                        MinHeight="200"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="0,0,0,0"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BorderColor}"
                        Background="White"
                        HorizontalContentAlignment="Stretch">

						<!-- ============================= -->
						<!-- COLUMNAS -->
						<!-- ============================= -->

						<DataGrid.Columns>

							<DataGridTextColumn
                                Header="Nombre"
                                Binding="{Binding Nombre}"
                                Width="2*"/>

							<DataGridTextColumn
                                Header="Licencia"
                                Binding="{Binding Licencia}"
                                Width="1.2*"/>

							<DataGridTextColumn
                                Header="Transporte"
                                Binding="{Binding Transporte}"
                                Width="1.5*"/>

						</DataGrid.Columns>


						<!-- ============================= -->
						<!-- HEADER -->
						<!-- ============================= -->

						<DataGrid.ColumnHeaderStyle>

							<Style TargetType="DataGridColumnHeader">

								<Setter
                                    Property="Height"
                                    Value="44"/>

								<Setter
                                    Property="Padding"
                                    Value="14,0"/>

								<Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Left"/>

								<Setter
                                    Property="VerticalContentAlignment"
                                    Value="Center"/>

								<Setter
                                    Property="FontWeight"
                                    Value="SemiBold"/>

								<Setter
                                    Property="Foreground"
                                    Value="{StaticResource TextColor}"/>

								<Setter
                                    Property="Background"
                                    Value="{StaticResource PrimarySoft}"/>

								<Setter
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderColor}"/>

								<Setter
                                    Property="BorderThickness"
                                    Value="0,0,0,1"/>

							</Style>

						</DataGrid.ColumnHeaderStyle>


						<!-- ============================= -->
						<!-- FILAS -->
						<!-- ============================= -->

						<DataGrid.RowStyle>

							<Style TargetType="DataGridRow">

								<Setter
                                    Property="Height"
                                    Value="48"/>

								<Setter
                                    Property="Background"
                                    Value="White"/>

								<Setter
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderColor}"/>

								<Setter
                                    Property="BorderThickness"
                                    Value="0,0,0,1"/>

								<Setter
                                    Property="VerticalContentAlignment"
                                    Value="Center"/>

								<Style.Triggers>

									<Trigger
                                        Property="IsMouseOver"
                                        Value="True">

										<Setter
                                            Property="Background"
                                            Value="{StaticResource PrimarySoft}"/>

									</Trigger>

									<Trigger
                                        Property="IsSelected"
                                        Value="True">

										<Setter
                                            Property="Background"
                                            Value="{StaticResource PrimarySoft}"/>

									</Trigger>

								</Style.Triggers>

							</Style>

						</DataGrid.RowStyle>


						<!-- ============================= -->
						<!-- CELDAS -->
						<!-- ============================= -->

						<DataGrid.CellStyle>

							<Style TargetType="DataGridCell">

								<Setter
                                    Property="Padding"
                                    Value="14,0"/>

								<Setter
                                    Property="VerticalContentAlignment"
                                    Value="Center"/>

								<Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Left"/>

								<Setter
                                    Property="BorderThickness"
                                    Value="0"/>

								<Setter
                                    Property="Foreground"
                                    Value="{StaticResource TextColor}"/>

							</Style>

						</DataGrid.CellStyle>

					</DataGrid>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</UserControl>