<UserControl x:Class="WpfApp1.Views.ReporteIngresosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- TITULO -->
        <!-- ========================================== -->

        <TextBlock
            Grid.Row="0"
            Text="Reporte de Ingresos"
            FontSize="22"
            FontWeight="Bold"
            Foreground="{StaticResource TextColor}"/>

        <TextBlock
            Grid.Row="1"
            Text="Consulta de ingresos registrados"
            Foreground="{StaticResource SecondaryTextColor}"
            Margin="0,6,0,12"/>


        <!-- ========================================== -->
        <!-- FILTROS -->
        <!-- ========================================== -->

        <Border
            Grid.Row="2"
            Style="{StaticResource CardStyle}">

            <StackPanel>

                <WrapPanel>

                    <!-- FECHA INICIO -->

                    <StackPanel Margin="0,0,12,0">

                        <TextBlock
                            Text="Fecha Inicio"
                            Style="{StaticResource LabelStyle}"/>

                        <DatePicker
                            SelectedDate="{Binding FechaInicio}"
                            Width="150"/>

                    </StackPanel>


                    <!-- FECHA FIN -->

                    <StackPanel Margin="0,0,12,0">

                        <TextBlock
                            Text="Fecha Fin"
                            Style="{StaticResource LabelStyle}"/>

                        <DatePicker
                            SelectedDate="{Binding FechaFin}"
                            Width="150"/>

                    </StackPanel>


                    <!-- ================================= -->
                    <!-- PLACA -->
                    <!-- ================================= -->

                    <StackPanel Margin="0,0,12,0">

                        <TextBlock
                            Text="Placa"
                            Style="{StaticResource LabelStyle}"/>

                        <ComboBox
                            Width="160"
                            Style="{StaticResource ComboBoxStyle}"
                            ItemsSource="{Binding Placas}"
                            SelectedItem="{Binding Placa, Mode=TwoWay}"
                            IsEditable="False"/>

                    </StackPanel>


                    <!-- CONDUCTOR -->

                    <StackPanel Margin="0,0,12,0">

                        <TextBlock
                            Text="Conductor"
                            Style="{StaticResource LabelStyle}"/>

                        <TextBox
                            Text="{Binding Conductor, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource InputStyle}"
                            Width="160"/>

                    </StackPanel>


                    <!-- PRODUCTO -->

                    <StackPanel>

                        <TextBlock
                            Text="Producto"
                            Style="{StaticResource LabelStyle}"/>

                        <TextBox
                            Text="{Binding Producto, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource InputStyle}"
                            Width="160"/>

                    </StackPanel>

                </WrapPanel>


                <!-- ================================= -->
                <!-- BOTONES -->
                <!-- ================================= -->

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

                    <Button
                        Content="Buscar"
                        Command="{Binding BuscarCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"/>

                    <Button
                        Content="Limpiar"
                        Command="{Binding LimpiarCommand}"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,8,0"/>

                    <Button
                        Content="Exportar"
                        Style="{StaticResource PrimaryButton}"/>

                </StackPanel>

            </StackPanel>

        </Border>


        <!-- ========================================== -->
        <!-- RESULTADOS -->
        <!-- ========================================== -->

        <Border
            Grid.Row="3"
            Style="{StaticResource CardStyle}"
            Margin="0,12,0,0">

            <DataGrid
                ItemsSource="{Binding Resultados}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                GridLinesVisibility="None"
                RowHeight="44"
                HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Fecha"
                        Binding="{Binding FechaHora}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Placa"
                        Binding="{Binding Placa}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Turno"
                        Binding="{Binding Turno}"
                        Width="100"/>

                    <DataGridTextColumn
                        Header="Conductor"
                        Binding="{Binding Conductor}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Producto"
                        Binding="{Binding Producto}"
                        Width="140"/>

                    <DataGridTextColumn
                        Header="Peso"
                        Binding="{Binding Peso}"
                        Width="100"/>

                    <DataGridTextColumn
                        Header="Transporte"
                        Binding="{Binding Transporte}"
                        Width="140"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>