<Window x:Class="WpfApp1.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Logística"
        Width="900"
        Height="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        ResizeMode="NoResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Left illustration / info -->
        <StackPanel Grid.Column="0" Margin="40">
            <TextBlock Text="Sistema de Logística" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextColor}" />
            <TextBlock Text="Control y gestión de operaciones logísticas" Margin="0,10,0,0" Foreground="{StaticResource SecondaryTextColor}"/>
            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Bienvenido" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextColor}" />
                    <TextBlock Text="Inicie sesión con su usuario y contraseña para acceder al panel." Foreground="{StaticResource SecondaryTextColor}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Login card -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Iniciar sesión" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextColor}" HorizontalAlignment="Center" />
                <TextBlock Text="Accede a tu cuenta" Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Center" Margin="0,6,0,18" />

                <TextBlock Text="Usuario" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" />

                <TextBlock Text="Contraseña" Style="{StaticResource LabelStyle}" Margin="0,12,0,6" />
                <PasswordBox x:Name="PasswordBox" Height="42" Padding="10" />

                <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource DangerColor}" Margin="0,10,0,0" TextWrapping="Wrap" />

                <Button Content="Ingresar" Command="{Binding IngresarCommand}" CommandParameter="{Binding ElementName=PasswordBox}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" />

                <TextBlock Text="Usuario: admin  |  Clave: 1234" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextColor}" FontSize="12" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
