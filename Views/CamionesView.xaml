<UserControl x:Class="WpfApp1.Views.CamionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Camiones" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextColor}"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Placa" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="Modelo" Style="{StaticResource LabelStyle}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="Transportista" Style="{StaticResource LabelStyle}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Transportista, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                    <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource SuccessColor}" Margin="0,8,0,0"/>
                </StackPanel>

                <DataGrid Grid.Column="1" ItemsSource="{Binding Camiones}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="*" />
                        <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="*" />
                        <DataGridTextColumn Header="Transportista" Binding="{Binding Transportista}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </StackPanel>

</UserControl>
